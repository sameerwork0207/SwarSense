# ─── SwarSense Backend — Environment Configuration ────────────────────────────
# Copy this file to .env and fill in values.
# DO NOT commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── File Upload Limits ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=600

# ─── Audio Processing ─────────────────────────────────────────────────────────
TARGET_SAMPLE_RATE=22050
SEGMENT_LENGTH_SECONDS=30

# ─── Model Paths (Phase 3+) ───────────────────────────────────────────────────
RAGA_MODEL_PATH=./models/raga/raga_cnn.pt
INSTRUMENT_MODEL_PATH=./models/instrument/

# ─── Data Paths ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
RAGA_KNOWLEDGE_PATH=./data/ragas.json

# ─── Song Intelligence (Phase 2, optional) ────────────────────────────────────
# Leave all of these unset to disable identification entirely (reported as
# 'unavailable' — never affects DSP results). Only one provider is used at a
# time; SONG_IDENTIFICATION_PROVIDER picks which one explicitly.
SONG_INTELLIGENCE_ENABLED=true
SONG_IDENTIFICATION_PROVIDER=acoustid     # acoustid | acrcloud | audd | auto
ACOUSTID_API_KEY=                         # Free key: https://acoustid.org/api-key
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
AUDD_API_TOKEN=                           # https://audd.io/
IDENTIFICATION_CONFIDENCE_THRESHOLD=0.75
IDENTIFICATION_DOMINANCE_MARGIN=0.15
SONG_INTELLIGENCE_TIMEOUT_SECONDS=15
